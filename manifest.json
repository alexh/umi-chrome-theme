      "toolbar": [42, 28, 18],
      "tab_text": [251, 241, 199],
      "tab_background_text": [213, 196, 161],
      "tab_background_text_inactive": [168, 153, 132],
      "bookmark_text": [251, 241, 199],
      "ntp_background": [26, 26, 26],
